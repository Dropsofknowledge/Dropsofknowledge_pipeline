# DropsofKnowledge - secrets. Never commit this file; never paste values into chat.
# Copy to .env and fill in real values.

# Transcription - Groq free tier (recommended): https://console.groq.com/keys
# whisper-large-v3, no credit card needed.
GROQ_API_KEY=gsk_your-key-here

# Optional overrides (defaults shown). Any OpenAI-compatible transcription
# endpoint works, e.g. OpenAI itself:
#   TRANSCRIBE_BASE_URL=https://api.openai.com/v1
#   TRANSCRIBE_MODEL=whisper-1
#   OPENAI_API_KEY=sk-...
TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1
TRANSCRIBE_MODEL=whisper-large-v3

# Task 3: Telegram audio auto-fetch via Telethon
# Get api_id/api_hash at https://my.telegram.org -> API development tools
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
TELEGRAM_SESSION=dok_fetcher
# Source channel to watch (id like -1001234567890, or @publicname)
TELEGRAM_SOURCE_GROUP=

# Task 6: LLM title/description drafting (defaults shown; Groq free tier works)
DRAFT_LLM_BASE_URL=https://api.groq.com/openai/v1
DRAFT_LLM_MODEL=openai/gpt-oss-120b

# Task 6: YouTube upload (Google Cloud OAuth client, scope youtube.upload)
YOUTUBE_CLIENT_ID=xxxx.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=xxxxxxxx
YOUTUBE_CATEGORY_ID=27
# OAuth token saved after --login (gitignored, excluded from backup)
YOUTUBE_TOKEN_FILE=state/youtube_token.json

# Task 6: TikTok Content Posting API (free; posts stay SELF_ONLY until your
# app passes the content audit at developers.tiktok.com)
TIKTOK_CLIENT_KEY=xxxxxxxx
TIKTOK_CLIENT_SECRET=xxxxxxxx
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
# token saved after --login (gitignored, excluded from backup)
TIKTOK_TOKEN_FILE=state/tiktok_token.json

# Task 6: Instagram Reels (free; needs IG Business/Creator account linked
# to a FB Page). Find IG_USER_ID with:
#   python scripts\upload_instagram.py --discover
IG_USER_ID=1784xxxxxxxxxxx
IG_ACCESS_TOKEN=xxxxxxxx

# Task 6: Facebook Page video (Graph API) - also used for --discover
FB_PAGE_ID=123456789012345
FB_PAGE_ACCESS_TOKEN=xxxxxxxx
FB_GRAPH_VERSION=v21.0
